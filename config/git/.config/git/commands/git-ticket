#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ge 1 ]]; then
  ID="$1"
else
  command -v ticket-pick >/dev/null || {
    echo "error: no ticket-pick on PATH; drop a hook script in your project's local/bin/ (see hook contract)" >&2
    exit 1
  }
  ID="$(ticket-pick)"
  [[ -n "$ID" ]] || exit 0
fi

TITLE="$(ticket-title "$ID")"

if git show-ref --verify --quiet "refs/heads/$ID"; then
  git checkout "$ID"
elif git show-ref --verify --quiet "refs/remotes/origin/$ID"; then
  git checkout -b "$ID" --track "origin/$ID"
else
  git checkout -b "$ID"
fi

git config branch."$ID".description "$TITLE"
