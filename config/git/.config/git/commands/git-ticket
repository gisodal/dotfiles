#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ge 1 ]]; then
  ID="$1"
else
  command -v ticket >/dev/null || {
    echo "error: no ticket on PATH; drop a hook script in your project's local/bin/ (see hook contract)" >&2
    exit 1
  }
  ID="$(ticket)"
  [[ -n "$ID" ]] || exit 0
fi

if command -v ticket-title >/dev/null; then
  if ! TITLE="$(ticket-title "$ID")"; then
    echo "error: ticket-title failed for $ID (exit $?)" >&2
    exit 1
  fi
else
  echo "warn: no ticket-title on PATH; skipping branch description" >&2
  TITLE=""
fi

if git show-ref --verify --quiet "refs/heads/$ID"; then
  git checkout "$ID"
elif git show-ref --verify --quiet "refs/remotes/origin/$ID"; then
  git checkout -b "$ID" --track "origin/$ID"
else
  git checkout -b "$ID"
fi

if [[ -n "$TITLE" ]]; then
  TITLE="$(printf '%s' "$TITLE" | head -1)"
  git config branch."$ID".description "$TITLE"
fi
