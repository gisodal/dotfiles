#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GIT_TICKET="$SELF_DIR/git-ticket"

[[ -x "$GIT_TICKET" ]] || { echo "git-ticket not found or not executable at $GIT_TICKET" >&2; exit 1; }

TMP="$(mktemp -d)"; TMP="$(cd "$TMP" && pwd -P)"
trap "rm -rf '$TMP'" EXIT

echo "running git-ticket smoke tests in $TMP"

HOOKS="$TMP/hooks"
TEST_PATH="$HOOKS:$SELF_DIR:/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin"

reset_hooks() { rm -rf "$HOOKS"; mkdir -p "$HOOKS"; }

write_hook() {
  local name="$1"; shift
  cat > "$HOOKS/$name"
  chmod +x "$HOOKS/$name"
}

make_repo() {
  local d="$1"
  rm -rf "$d"; mkdir -p "$d"
  git -C "$d" init -q -b main
  git -C "$d" -c user.email=a@b -c user.name=a commit --allow-empty -q -m init
  git -C "$d" branch -M main
}

run_in() {
  local repo="$1"; shift
  ( cd "$repo" && PATH="$TEST_PATH" git ticket "$@" )
}

#--- test 1: picker happy path ------------------------------------------------
reset_hooks
write_hook ticket-pick <<'PICK'
#!/usr/bin/env bash
echo "T-1"
PICK
write_hook ticket-title <<'TITLE'
#!/usr/bin/env bash
echo "Hello world"
TITLE

R="$TMP/repo1"; make_repo "$R"
run_in "$R" >/dev/null 2>&1 || { echo "❌ test 1 failed: git ticket errored" >&2; exit 1; }
git -C "$R" rev-parse --verify --quiet refs/heads/T-1 >/dev/null \
  || { echo "❌ test 1 failed: branch T-1 not created" >&2; exit 1; }
got="$(git -C "$R" config branch.T-1.description || true)"
[[ "$got" == "Hello world" ]] \
  || { echo "❌ test 1 failed: description='$got' (expected 'Hello world')" >&2; exit 1; }
echo "✅ test 1: picker happy path"

#--- test 2: direct id skips picker ------------------------------------------
reset_hooks
write_hook ticket-pick <<'PICK'
#!/usr/bin/env bash
echo "ticket-pick was called when it shouldn't have been" >&2
exit 99
PICK
write_hook ticket-title <<'TITLE'
#!/usr/bin/env bash
echo "Direct title for $1"
TITLE

R="$TMP/repo2"; make_repo "$R"
run_in "$R" T-2 >/dev/null 2>&1 || { echo "❌ test 2 failed: git ticket T-2 errored" >&2; exit 1; }
git -C "$R" rev-parse --verify --quiet refs/heads/T-2 >/dev/null \
  || { echo "❌ test 2 failed: branch T-2 not created" >&2; exit 1; }
got="$(git -C "$R" config branch.T-2.description || true)"
[[ "$got" == "Direct title for T-2" ]] \
  || { echo "❌ test 2 failed: description='$got'" >&2; exit 1; }
echo "✅ test 2: direct id skips picker"

#--- test 3: existing branch — refresh description ---------------------------
reset_hooks
write_hook ticket-title <<'TITLE'
#!/usr/bin/env bash
echo "Refreshed title"
TITLE

R="$TMP/repo3"; make_repo "$R"
git -C "$R" branch T-3
git -C "$R" config branch.T-3.description "Old title"

run_in "$R" T-3 >/dev/null 2>&1 || { echo "❌ test 3 failed: git ticket T-3 errored" >&2; exit 1; }
[[ "$(git -C "$R" symbolic-ref --short HEAD)" == "T-3" ]] \
  || { echo "❌ test 3 failed: HEAD is not on T-3" >&2; exit 1; }
got="$(git -C "$R" config branch.T-3.description || true)"
[[ "$got" == "Refreshed title" ]] \
  || { echo "❌ test 3 failed: description='$got' (expected 'Refreshed title')" >&2; exit 1; }
echo "✅ test 3: existing branch refresh"

echo "all tests passed"
